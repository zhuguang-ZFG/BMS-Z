{
  "title": "BMS 实战：从一颗电芯到一套证据链",
  "version": "0.4.2",
  "part_goals": {
    "p0": "明确本书的实验口径：分清实测、合成、参考值与独立真值。",
    "p1": "从电芯物理走到测量链，画出系统边界，量出误差如何进入决策。",
    "p2": "把越限变成有时间预算的动作，检查切断反馈与均衡的能量账。",
    "p3": "由测量建立模型，用独立工况和残差说明参数与估计的适用边界。",
    "p4": "沿着帧、信号、日志和数据集逐层对账，判断一份数据何时可用。",
    "p5": "把开源工具、仿真和 AI 纳入开发流程，用阶段门组织交付证据。",
    "p6": "展开矩阵、曲线、字节和热账，用数值实验检验每一个推导。",
    "p7": "读懂诊断生命周期、刷写恢复和高压系统的测量与动作边界。",
    "p8": "用项目清单、术语、资料和答案回查正文，组织自己的复现记录。"
  },
