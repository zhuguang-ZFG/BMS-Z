    "definitions": {
      "intro": "导读/现场/押注：lead 段≥50字符且含边界声明（不能/不代表/不证明/边界/待验）；导读只许声明本单元 levels 里实际存在的能力与边界",
      "core": "概念与机制：样章/研究单元≥1 张 mechanism 图；桥梁/概念单元源文件≥2 个标题",
      "derivation": "推导与冻结数值：≥1 条登记断言（标题锚点+节指纹）",
      "lab": "动手与独立任务：≥1 个登记实验（学生任务/反例/冻结三锚点已验）",
      "research": "研究深化支线：仅 R 单元可标；须含边界声明，不授予产品资质"
    },
    "filtering_rule": "层级是渲染层阅读过滤器（P2.6/P2.7 装配实现），浅层关闭不得删除或改写技术正文；正文永远完整交付，检索与离线包不受层级影响"
  }
}
