# 本机 Agent / IDE 配置
.claude/settings.local.json
**/.claude/settings.local.json
.qoder/

# Obsidian：共享配置（app/appearance/core-plugins）入库；窗口布局与最近打开是本机状态，不入库
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc

# 构建与运行产物
*.exe
*.o
code/soc/soc_comparison.png
code/firmware/pc-demo-output/
code/soc/real-data-output/
.playwright-mcp/
# 本地实测截图与临时产物（改皮肤时量的那张图就落在这），只在本机看，不入库
.local/

# 视频工程产物：分镜 JSON 与工具入库，但帧、配音、混音、MP4 动辄几 GB，且是可重算的
# 派生物（真源是 tools/video/specs/*.json + docs/ 正文），照 dist/ 的先例不入库
media/

# 文档站（VitePress）：依赖与构建产物不入库，CI 里用 npm ci 现装
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
# Vite 的依赖预构建缓存在异常退出时会落到仓库根的 .vitepress/（站点配置在 docs/ 下）
/.vitepress/

# 本机工具留下的临时脚本（约定以 .tmp- 开头，如 .tmp-inject-style.py）
.tmp-*

# 书籍/白皮书 PDF 本地副本：版权限制再分发，不入库（同瑞萨白皮书先例）
books/
/*.pdf

# 本书的 HTML/PDF 与合并稿可重新构建，原稿和插图入库。
bms-book/dist/
docs/book/
